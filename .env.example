# =============================================================================
# Music Tuition Portal — single environment file (backend + frontend)
# Copy to `.env` in this folder (setup.ps1 does this automatically).
# Backend: run-backend.ps1   |   Frontend: Vite reads VITE_* from here too
# =============================================================================

# --- Backend (ASP.NET Core) ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# Sqlite | Postgres
DatabaseProvider=Sqlite

# PostgreSQL (when DatabaseProvider=Postgres)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=music_tuition_portal;Username=postgres;Password=postgres

# SQLite (when DatabaseProvider=Sqlite)
ConnectionStrings__SqliteConnection=Data Source=music_tuition_portal.db

# JWT — change Secret in production
Jwt__Secret=MusicTuitionPortal-SuperSecretKey-ChangeInProduction-2025!
Jwt__Issuer=MusicTuitionPortal
Jwt__Audience=MusicTuitionPortalUsers
Jwt__ExpiryHours=24

# Comma-separated origins allowed for CORS
Cors__AllowedOrigins=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (VITE_* only — safe to expose in browser bundle) ---
VITE_API_URL=http://localhost:5000/api
VITE_API_PROXY_TARGET=http://localhost:5000
VITE_DEV_PORT=5173
VITE_USE_MOCK=false
VITE_APP_NAME=Music Tuition Portal

# Billplz FPX (https://www.billplz.com) — sandbox: https://www.billplz-sandbox.com
Billplz__ApiKey=
Billplz__CollectionId=
Billplz__XSignatureKey=
Billplz__Sandbox=true
Billplz__CallbackUrl=http://localhost:5000/api/payments/billplz/callback
Billplz__RedirectUrl=http://localhost:5000/api/payments/billplz/redirect
Billplz__FrontendReturnUrl=http://localhost:5173/parent/invoices

# Future: email (password reset, invoice notices)
# SMTP__Host=
# SMTP__Port=587
# SMTP__User=
# SMTP__Password=
# SMTP__From=noreply@yourcentre.com
