# =============================================================================
# Music Tuition Portal — copy to `.env` (setup.ps1 does this automatically)
# =============================================================================

# --- App / centre branding (change these to rename the portal) ---
# VITE_APP_NAME     — browser tab title
# VITE_CENTRE_NAME  — name shown in sidebar, login, invoices (frontend)
# CentreName        — seeded centre name in the database (backend)
VITE_APP_NAME=Harmony Music Center
VITE_CENTRE_NAME=Harmony Music Center
CentreName=Harmony Music Center

# --- URLs ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
VITE_API_URL=http://localhost:5000/api
VITE_API_PROXY_TARGET=http://localhost:5000
VITE_DEV_PORT=5173
Cors__AllowedOrigins=http://localhost:5173,http://127.0.0.1:5173

# --- Database (portal app + ERP both use Firebird PORTAL.FDB) ---
DatabaseProvider=Firebird
ConnectionStrings__FirebirdConnection=
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=music_tuition_portal;Username=postgres;Password=postgres
SqlAccount__DbUser=SYSDBA
SqlAccount__DbPassword=masterkey

# --- JWT (change Secret in production) ---
Jwt__Secret=MusicTuitionPortal-SuperSecretKey-ChangeInProduction-2025!
Jwt__Issuer=MusicTuitionPortal
Jwt__Audience=MusicTuitionPortalUsers
Jwt__ExpiryHours=24

VITE_USE_MOCK=false

# Password (lock) logins shown below /login — Role|email|password;...
VITE_DEMO_LOGINS=Admin|admin@demo.com|Admin@123;Teacher|sarah.chen@demo.com|Teacher@123;Teacher|david.wong@demo.com|Teacher@123;Student|emily.tan@demo.com|Student@123;Student|james.lim@demo.com|Student@123;Parent|michael.tan@demo.com|Parent@123;Parent|lisa.lim@demo.com|Parent@123
VITE_DEMO_LOGIN_EMAIL=admin@demo.com
VITE_DEMO_LOGIN_PASSWORD=Admin@123

Billplz__ApiKey=
Billplz__CollectionId=
Billplz__XSignatureKey=
Billplz__Sandbox=true
Billplz__CallbackUrl=http://localhost:5000/api/payments/billplz/callback
Billplz__RedirectUrl=http://localhost:5000/api/payments/billplz/redirect
Billplz__FrontendReturnUrl=http://localhost:5173/parent/invoices

# --- SQL Account ERP (read-only customer view) ---
# Generate keys in SQL Account: Tools > Maintain User > Detail > More > API Secret Key
SqlAccount__DatabasePath=C:\eStream\SQLAccounting\DB\PORTAL.FDB
SqlAccount__ApiBaseUrl=https://api.sql.my
SqlAccount__AccessKey=
SqlAccount__SecretKey=
SqlAccount__Service=execute-api
SqlAccount__Region=ap-southeast-1

# Parent login via AR_CUSTOMER udf_email (BypassOtp=true skips OTP check in dev)
Auth__BypassOtp=true
Auth__DevParentEmails=parent@gmail.com
# Admin login via SY_USER email + UDF_ISADMIN when FDB/API lookup is unavailable (testing only)
Auth__DevAdminEmails=admin@gmail.com
# Demo teachers (SY_USER EMAIL, UDF_ISADMIN=false): test1@gmail.com … test5@gmail.com — see scripts/README-demo-seed.md

# Homework file uploads (optional; default: Uploads/homework under API content root)
# Homework__UploadPath=C:\path\to\homework-uploads
